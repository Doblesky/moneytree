<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du sélecteur de widgets : textes d exemple, sans aucun chiffre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/entete"
            android:text="Bases · Découverte"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#C69A3F"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/fictif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/fictif"
            android:textColor="#C9D3C6"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/suivante"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/suivante"
            android:gravity="center"
            android:text="›"
            android:textColor="#C69A3F"
            android:textSize="26sp"
            android:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/titre"
        android:text="Une carte de tes cours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="2"
        android:textColor="#F4EEDF"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/texte"
        android:text="Chaque carte des paliers que tu maîtrises revient à son tour, pour garder l’essentiel en tête."
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:textColor="#E9E3D2"
        android:textSize="14sp" />
</LinearLayout>
