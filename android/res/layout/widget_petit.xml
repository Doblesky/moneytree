<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 : nom du module et titre de la carte. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/entete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#C69A3F"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/fictif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/fictif"
            android:textColor="#C9D3C6"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/suivante"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:contentDescription="@string/suivante"
            android:gravity="center"
            android:text="›"
            android:textColor="#C69A3F"
            android:textSize="24sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/titre"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="4"
        android:fontFamily="serif"
        android:textColor="#F4EEDF"
        android:textSize="16sp" />
</LinearLayout>
